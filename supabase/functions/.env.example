# Edge function secrets. Copy to supabase/functions/.env (git-ignored) for
# `npm run functions:serve`, and push to the hosted project with:
#   npx supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase itself; do not set them here.

# LiveKit Cloud project. The API secret never leaves the backend.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Signs invitation tokens. Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every invitation link already sent.
INVITE_TOKEN_SECRET=

# The App Link host serving web/invite. Invitation links are <this>/join/<token>.
INVITE_BASE_URL=https://framecue-invite.example
