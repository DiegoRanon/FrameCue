{
  "name": "framecue",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "node scripts/android-run.mjs",
    "prebuild:android": "expo prebuild --platform android && node scripts/android-jdk.mjs",
    "prebuild:clean": "expo prebuild --platform android --clean && node scripts/android-jdk.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "doctor": "npx expo-doctor",
    "android:install": "node scripts/android-run.mjs --no-build",
    "android:expo": "node scripts/android-jdk.mjs && expo run:android",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/backend/database.types.ts",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "dependencies": {
    "@livekit/components-react": "^2.9.24",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "livekit-client": "^2.19.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "react-dom": "19.2.3",
    "supabase": "^2.117.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  }
}
